{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remote Mic",
  "version": "0.1.0",
  "identifier": "com.shiroaky.remote-mic",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Remote Mic",
        "width": 800,
        "height": 600,
        "center": true,
        "decorations": false,
        "devtools": false,
        "resizable": false,
        "titleBarStyle": "Transparent",
        "shadow": true,
        "maximizable": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.ico"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFOTVFQTFFMTU3Njc3NkQKUldSdGQzWVZIdXFWN2lRMzR2OHFoaXJ2cjBxTTREUUs5WVM3ckZGQXJoSnpzQkhrNW9MYjlGbjYK",
      "endpoints": [
        "https://github.com/ShiroAky/remote-mic/releases/latest/download/latest.json"
      ]
    }
  }
}
